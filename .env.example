# Optional. If empty, worker API calls are accepted without a key.
WORKER_API_KEY=change-this-to-a-long-random-secret

# Optional production PostgreSQL URL from Render.
# Example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Worker settings
API_URL=http://127.0.0.1:5000
CAMERA_ID=1
CAMERA_SOURCE=0
CAMERA_NAME=Classroom Camera 1
CAMERA_LOCATION=Classroom
